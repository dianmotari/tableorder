# Copy this file to ".env" and fill in values.
# NEVER paste secrets into chat. Keep them only in this local .env file.

# --- Database ---
# Leave EMPTY for local SQLite (a file called tableorder.db is created).
# For PostgreSQL (online) set something like:
# DATABASE_URL=postgresql://user:password@host:5432/tableorder
DATABASE_URL=

# --- Security ---
# A long random string used to sign cookies. Generate one and paste it here.
# Example (run in PowerShell): python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Set to 1 when online over HTTPS; leave 0 for local http development.
COOKIE_SECURE=0

# Public address phones should open (used inside printed QR codes).
# Local dev example: http://192.168.1.10:8000  (your PC's LAN IP, not 127.0.0.1)
# Online example:    https://menu.yourhotel.com
# Leave blank to fall back to the request's own host.
BASE_URL=

# --- First admin (created automatically on first run if no admin exists) ---
# After the admin exists you can clear these two lines.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-now

# --- Google sign-in (customers) ---
# From https://console.cloud.google.com/apis/credentials (OAuth client ID).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email OTP (customers without Google) ---
# Option A: Gmail/any SMTP (works with a free Gmail + App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Option B: Resend HTTP API (used only if SMTP above is empty).
EMAIL_API_KEY=
# From address for either method (Gmail: use the SMTP_USER address).
EMAIL_FROM=